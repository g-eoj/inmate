#!/bin/bash

set -euo pipefail

ROOT=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
IMAGE_DIR="$ROOT/image"
IMAGE=inmate:latest
KEYCHAIN_SERVICE=inmate
KEYCHAIN_ACCOUNT=claude-code-oauth-token
GITHUB_ACCOUNT=github-token

warn() { printf 'inmate: %s\n' "$*" >&2; }
die() { warn "$@"; exit 1; }

keychain_token() {
  security find-generic-password -s "$KEYCHAIN_SERVICE" -a "$KEYCHAIN_ACCOUNT" -w 2>/dev/null
}

github_token() {
  security find-generic-password -s "$KEYCHAIN_SERVICE" -a "$GITHUB_ACCOUNT" -w 2>/dev/null
}

ensure_container_running() {
  command -v container > /dev/null || die "Apple 'container' CLI not found. Install with: brew install container"

  local status=0
  perl -e 'alarm shift; exec @ARGV' 15 container system status > /dev/null 2>&1 || status=$?
  if [ "$status" -eq 142 ]; then
    die "'container system status' hung (apple/container#2275). Try: sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setstealthmode on, then reboot."
  fi
  if [ "$status" -ne 0 ]; then
    warn "starting the container system service..."
    container system start "$@"
  fi
}

build_image() {
  local dockerfile version

  dockerfile=$(mktemp)
  cat "$IMAGE_DIR"/fragments/*.Dockerfile > "$dockerfile"

  # no dangling images
  container image delete "$IMAGE" > /dev/null 2>&1 || true

  version=$(curl -fsSL https://downloads.claude.ai/claude-code-releases/latest) || die "could not look up the Claude Code version"
  case "$version" in
    *[!0-9.]*|'') die "unexpected Claude Code version: '$version'" ;;
  esac
  container build -t "$IMAGE" -f "$dockerfile" --build-arg CLAUDE_VERSION="$version" "$IMAGE_DIR" > /dev/null

  rm -f "$dockerfile"
}

login() {
  [ -t 0 ] && [ -t 1 ] || die "login needs an interactive terminal"

  local log token
  log=$(mktemp)
  script -q "$log" container run --rm -it -e TERM "$IMAGE" claude setup-token || true
  token=$(tr -d '\r' < "$log" | grep -o 'sk-ant-oat01-[A-Za-z0-9_-]*' | tail -1) || true
  rm -f "$log"

  case "$token" in
    '' | *[!A-Za-z0-9_-]*) die "login failed: no token was printed" ;;
  esac

  printf 'add-generic-password -U -s %s -a %s -w %s\n' \
    "$KEYCHAIN_SERVICE" "$KEYCHAIN_ACCOUNT" "$token" | security -i
  printf 'Logged in. Token stored in the Keychain.\n'
}

github_login() {
  [ -t 0 ] && [ -t 1 ] || die "GitHub token entry needs an interactive terminal"

  local token
  read -r -s -p "GitHub token: " token
  printf '\n'
  case "$token" in
    '' | *[!A-Za-z0-9_-]*) warn "GitHub token not set" ;;
    *)
      printf 'add-generic-password -U -s %s -a %s -w %s\n' \
        "$KEYCHAIN_SERVICE" "$GITHUB_ACCOUNT" "$token" | security -i
      printf 'GitHub token stored in the Keychain.\n'
      ;;
  esac
}

cmd_run() {
  local project
  project=$(pwd -P)
  case "$project" in
    *[:,]*) die "project path contains ':' or ',' which 'container -v' can't mount: '$project'" ;;
    "$HOME"/*) ;;
  *) die "refusing to run outside home: '$project'"
  esac

  ensure_container_running 
  container image inspect "$IMAGE" > /dev/null 2>&1 || die "image not built; run inmate setup"
  CLAUDE_CODE_OAUTH_TOKEN=$(keychain_token) || die "not logged in; run inmate setup"
  GH_TOKEN=$(github_token) || GH_TOKEN=

  local args=(run --rm -it --name "inmate-$RANDOM$RANDOM" -v "$project:$project" -w "$project")
  local var
  for var in CLAUDE_CODE_OAUTH_TOKEN GH_TOKEN TERM; do
    if [ -n "${!var-}" ]; then
      export "${var?}"
      args+=(-e "$var")
    fi
  done

  saved_tty=$(stty -g)
  trap 'stty "$saved_tty"' exit
  stty -onlcr
  container "${args[@]}" "$IMAGE" "$@"
}

cmd_setup() {
  ensure_container_running --enable-kernel-install
  build_image
  keychain_token > /dev/null || login
  github_token > /dev/null || github_login
  printf 'Setup complete.\n'
}

main() {
  case "${1-}" in
    '' | -h | --help) printf 'usage: inmate setup | inmate <cmd> [args]\n' ;;
    setup) cmd_setup ;;
    -*) die "unknown option '$1'" ;;
    *) cmd_run "$@" ;;
  esac
}

main "$@"
