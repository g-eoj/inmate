#!/bin/bash
# inmate: run a command (usually Claude Code) in an Apple `container` VM that
# can see only the current directory.
#
#   inmate setup          choose toolchains, build the image, store the token
#   inmate build          rebuild the image from ~/.config/inmate/Dockerfile
#   inmate update         rebuild only the Claude Code layer
#   inmate token          store a `claude setup-token` token in the Keychain
#   inmate <cmd> [args]   run <cmd> in the VM, e.g. `inmate claude`, `inmate bash`
#   inmate -- <cmd>       same, for commands named like the subcommands above

set -euo pipefail

# Written for the bash 3.2 that ships with macOS, so it avoids bash 4 features
# like associative arrays and ${var,,}. Under set -u, bash 3.2 also treats
# "${a[@]}" of an empty array as unbound, so check ${#a[@]} before expanding.

INMATE_ROOT=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd -P)
IMAGE_DIR="$INMATE_ROOT/image"  # build context: Dockerfile fragments + entrypoint.sh
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/inmate"
CONFIG_FILE="$CONFIG_DIR/config"
DOCKERFILE="$CONFIG_DIR/Dockerfile"
KEYCHAIN_SERVICE=inmate
KEYCHAIN_ACCOUNT=claude-code-oauth-token

# Defaults, overridden by the config file and then by INMATE_* env vars.
image=inmate:latest
memory=8g
cpus=4
allowed=()  # allow= entries: inmate runs only inside these directories

warn() { printf 'inmate: %s\n' "$*" >&2; }
die() { warn "$@"; exit 1; }

# Print the header comment above (everything up to the first blank line).
usage() { sed -n '2,/^$/s/^# \{0,1\}//p' "${BASH_SOURCE[0]}"; }

# Run a command with a time limit. Exit status 142 (SIGALRM) means it timed out.
with_timeout() {
  local secs=$1; shift
  perl -e 'alarm shift; exec @ARGV' "$secs" "$@"
}

# Ask a yes/no question. $2 is the default answer, y or n.
confirm() {
  local answer hint='[y/N]'
  [ "$2" = y ] && hint='[Y/n]'
  read -r -p "$1 $hint " answer || answer=
  [[ ${answer:-$2} == [Yy]* ]]
}

# Strip leading and trailing whitespace (including a CR from CRLF files) from
# the variable named $1, in place.
trim() {
  local s=${!1}
  s=${s#"${s%%[![:space:]]*}"}
  s=${s%"${s##*[![:space:]]}"}
  printf -v "$1" '%s' "$s"
}

load_config() {
  local key value
  if [ -f "$CONFIG_FILE" ]; then
    while IFS='=' read -r key value || [ -n "$key" ]; do
      trim key
      trim value
      case "$key" in
        image) image=$value ;;
        memory) memory=$value ;;
        cpus) cpus=$value ;;
        allow) allowed+=("$value") ;;
        '' | '#'*) ;;
        *) warn "ignoring unknown key '$key' in $CONFIG_FILE" ;;
      esac
    done < "$CONFIG_FILE"
  fi
  image=${INMATE_IMAGE:-$image}
  memory=${INMATE_MEMORY:-$memory}
  cpus=${INMATE_CPUS:-$cpus}
  # INMATE_ALLOW replaces the allow= list; separate entries with ':'.
  if [ -n "${INMATE_ALLOW-}" ]; then
    IFS=: read -r -a allowed <<< "$INMATE_ALLOW"
  fi
}

# Make sure the `container` CLI is installed and its system service is running.
# Extra arguments go to `container system start` if it has to be started; setup
# passes --enable-kernel-install to accept the kernel download.
container_checked=
ensure_container_running() {
  [ -z "$container_checked" ] || return 0
  container_checked=1
  command -v container > /dev/null || die "Apple 'container' CLI not found. Install it with: brew install container"

  local status=0
  with_timeout 15 container system status > /dev/null 2>&1 || status=$?
  if [ "$status" -eq 142 ]; then
    die "'container system status' hung. On macOS 27 this is apple/container#2275; the reported fix is
  sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setstealthmode on
and a reboot."
  fi
  if [ "$status" -ne 0 ]; then
    warn "starting the container system service..."
    container system start "$@"
  fi
}

image_exists() { container image inspect "$image" > /dev/null 2>&1; }

# Print the physical path of an allow= entry, which must be absolute or start
# with ~/. Fails otherwise, or if the directory doesn't exist. Anything else
# (empty, relative) would resolve against the current directory, i.e. the
# project itself, and allow everything.
resolve_dir() {
  local dir=$1
  case "$dir" in
    \~ | \~/*) dir=$HOME${dir#\~} ;;
    /*) ;;
    *) return 1 ;;
  esac
  (cd "$dir" 2> /dev/null && pwd -P)
}

# Print the physical path of an absolute path that need not exist yet: resolve
# the nearest existing ancestor and re-append the rest.
physical_path() {
  local p=$1 rest=
  while [ ! -d "$p" ]; do
    rest=/$(basename "$p")$rest
    p=$(dirname "$p")
  done
  printf '%s%s' "$(cd "$p" && pwd -P)" "$rest"
}

# Directory containment tests on physical paths. Matching "$1/" against "$2/..."
# keeps ~/projects-old from counting as inside ~/projects. is_within accepts
# $2 itself; is_below (the ?) requires $1 to be strictly deeper.
is_within() { [[ $1/ == "$2"/* ]]; }
is_below() { [[ $1/ == "$2"/?* ]]; }

# Refuse to run unless the project is inside your home directory (not home
# itself) and, if allow= entries are configured, inside one of them.
check_project_dir() {
  local project=$1 home dir entry root
  case "$project" in
    *:* | *,*) die "can't mount '$project': ':' and ',' in paths break container mount syntax" ;;
  esac
  home=$(physical_path "$HOME")
  if ! is_below "$project" "$home"; then
    die "refusing to expose '$project': inmate only runs in directories inside your home directory"
  fi

  # A project that overlaps inmate's own files would let the VM rewrite the
  # allowlist, the Dockerfile, or the script the host runs next time. That
  # includes the directory of the symlink we were invoked through, wherever it
  # lives, plus install.sh's default. Some of these dirs don't exist before
  # setup, hence physical_path.
  for dir in "$CONFIG_DIR" "$INMATE_ROOT" "$(dirname "${BASH_SOURCE[0]}")" "$HOME/.local/bin"; do
    dir=$(physical_path "$dir")
    if is_within "$dir" "$project" || is_within "$project" "$dir"; then
      die "refusing to expose '$project': it overlaps inmate's own files in $dir"
    fi
  done

  # No allow= entries means anywhere inside home is fine.
  if [ ${#allowed[@]} -eq 0 ]; then return 0; fi
  for entry in "${allowed[@]}"; do
    if ! root=$(resolve_dir "$entry"); then
      warn "ignoring allow=$entry: not an existing absolute or ~/ directory"
      continue
    fi
    if is_within "$project" "$root"; then return 0; fi
  done
  die "refusing to expose '$project': it isn't inside any allow= directory in $CONFIG_FILE"
}

# Container names must be unique, so combine the project name and a random suffix.
container_name() {
  local slug
  slug=$(basename "$1" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-*//; s/-*$//' | cut -c1-30)
  printf 'inmate-%s-%04x%04x' "${slug:-project}" "$RANDOM" "$RANDOM"
}

keychain_token() {
  security find-generic-password -s "$KEYCHAIN_SERVICE" -a "$KEYCHAIN_ACCOUNT" -w 2> /dev/null
}

load_token() {
  if [ -z "${CLAUDE_CODE_OAUTH_TOKEN-}" ]; then
    CLAUDE_CODE_OAUTH_TOKEN=$(keychain_token) ||
      warn "no Claude token in the Keychain (run: inmate token); Claude will ask you to log in"
  fi
}

# Read the timezone name from the /etc/localtime symlink,
# e.g. .../zoneinfo/Europe/Berlin -> Europe/Berlin.
host_timezone() {
  local target
  target=$(readlink /etc/localtime 2> /dev/null) || return 0
  printf '%s' "${target#*zoneinfo/}"
}

cmd_run() {
  [ $# -gt 0 ] || die "usage: inmate <command> [args...]"

  local project
  project=$(pwd -P)
  check_project_dir "$project"

  ensure_container_running
  image_exists || die "image '$image' not found; run: inmate setup"
  load_token

  # These are exported and passed through by name in the loop below.
  TZ=${TZ:-$(host_timezone)}
  local name email
  # shellcheck disable=SC2034
  if name=$(git config --get user.name); then
    GIT_AUTHOR_NAME=$name GIT_COMMITTER_NAME=$name
  fi
  # shellcheck disable=SC2034
  if email=$(git config --get user.email); then
    GIT_AUTHOR_EMAIL=$email GIT_COMMITTER_EMAIL=$email
  fi

  local args=(run --rm --progress none
    --name "$(container_name "$project")"
    --memory "$memory" --cpus "$cpus"
    -v "$project:$project" -w "$project")
  # Pass these through by name (`-e VAR`, no value) so the token and the rest
  # never appear in argv, where `ps` would show them. This list is the only
  # place that decides what enters the VM.
  local var
  for var in CLAUDE_CODE_OAUTH_TOKEN TERM COLORTERM TZ \
    GIT_AUTHOR_NAME GIT_COMMITTER_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_EMAIL; do
    if [ -n "${!var-}" ]; then
      export "${var?}"
      args+=(-e "$var")
    fi
  done

  if [ -t 0 ] && [ -t 1 ]; then
    args+=(-it)
    # apple/container#2299 leaves ONLCR on in raw mode, which garbles
    # full-screen TUIs like Claude Code. Turn it off, then restore on exit.
    # (Global, not local: the EXIT trap must still see it.)
    saved_tty=$(stty -g)
    trap 'stty "$saved_tty"' EXIT
    stty -onlcr
  fi

  # set -e propagates a nonzero status as our exit status, after the EXIT trap.
  container "${args[@]}" "$image" "$@"
}

cmd_build() {
  [ -f "$DOCKERFILE" ] || die "$DOCKERFILE not found; run: inmate setup"
  ensure_container_running
  container build -t "$image" -f "$DOCKERFILE" "$@" "$IMAGE_DIR"
}

cmd_update() {
  cmd_build --build-arg "CLAUDE_CACHE_BUST=$(date +%s)" "$@"
}

cmd_token() {
  local token
  # shellcheck disable=SC2016 # literal backticks
  printf 'Run `claude setup-token` on this Mac (in another terminal), then paste the token here.\n'
  IFS= read -r -s -p 'Token: ' token || token=
  printf '\n'
  # Tokens contain only these characters. Checking also makes it safe to
  # splice the token into the `security -i` command below.
  case "$token" in
    '' | *[!A-Za-z0-9_-]*) die "that doesn't look like a token" ;;
  esac
  # `security -i` reads the command from stdin, so the token never shows up in argv.
  printf 'add-generic-password -U -s %s -a %s -w %s\n' \
    "$KEYCHAIN_SERVICE" "$KEYCHAIN_ACCOUNT" "$token" | security -i
  printf 'Stored in the Keychain (service "%s").\n' "$KEYCHAIN_SERVICE"
}

# Assemble ~/.config/inmate/Dockerfile from the base fragment, the toolchains
# you pick, and the Claude Code fragment. Fragment numbers fix the order:
# 00 is the base, 1x-8x are optional toolchains, 9x always come last.
write_dockerfile() {
  local fragments="$IMAGE_DIR/fragments"
  local picked=("$fragments"/0*.Dockerfile)
  local f label
  for f in "$fragments"/[1-8]*.Dockerfile; do
    label=$(basename "$f" .Dockerfile)
    label=${label#*-}
    if confirm "Include $label?" y; then picked+=("$f"); fi
  done
  picked+=("$fragments"/9*.Dockerfile)

  {
    # shellcheck disable=SC2016 # literal backticks
    printf '# Generated by `inmate setup`. Edit freely, then run `inmate build`.\n'
    printf '# The build context is %s, which provides entrypoint.sh.\n' "$IMAGE_DIR"
    for f in "${picked[@]}"; do
      printf '\n'
      cat "$f"
    done
  } > "$DOCKERFILE"
  printf 'Wrote %s\n' "$DOCKERFILE"
}

cmd_setup() {
  ensure_container_running --enable-kernel-install
  mkdir -p "$CONFIG_DIR"

  if [ ! -f "$DOCKERFILE" ] || confirm "$DOCKERFILE exists. Replace it?" n; then
    write_dockerfile
  fi

  if [ ! -f "$CONFIG_FILE" ]; then
    local projects
    while :; do
      read -r -p 'Only allow inmate inside this directory, e.g. ~/projects (blank: anywhere in your home): ' projects || projects=
      trim projects
      [ -z "$projects" ] && break
      resolve_dir "$projects" > /dev/null && break
      warn "'$projects' must be an existing directory, given as an absolute path or ~/..."
    done
    {
      # Defaults stay commented out so later changes to them still apply.
      printf '# image=%s\n# memory=%s\n# cpus=%s\n' "$image" "$memory" "$cpus"
      printf '# inmate only runs inside your home directory. allow= lines narrow that\n'
      printf '# further: with any present, the project must be inside one of them.\n'
      if [ -n "$projects" ]; then
        printf 'allow=%s\n' "$projects"
      else
        printf '# allow=~/projects\n'
      fi
    } > "$CONFIG_FILE"
    printf 'Wrote %s\n' "$CONFIG_FILE"
  fi

  cmd_build

  keychain_token > /dev/null || cmd_token
  printf '\nDone. cd into a project and run: inmate claude\n'
}

main() {
  load_config
  case "${1-}" in
    '' | -h | --help | help) usage ;;
    setup | build | update | token) "cmd_$1" "${@:2}" ;;
    --)
      shift
      cmd_run "$@"
      ;;
    -*) die "unknown option '$1' (see: inmate --help)" ;;
    *) cmd_run "$@" ;;
  esac
}

main "$@"
