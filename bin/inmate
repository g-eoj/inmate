#!/bin/bash

set -euo pipefail

ROOT=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
IMAGE_DIR="$ROOT/image"
IMAGE=inmate:latest
INMATE_CPUS="${INMATE_CPUS:-4}"
INMATE_MEMORY="${INMATE_MEMORY:-8G}"  # upper bound, used lazily
INMATE_SHADOW_DIRS="${INMATE_SHADOW_DIRS:-.venv .build}"
INMATE_XCODE_BRIDGE_PORT="${INMATE_XCODE_BRIDGE_PORT:-8765}"
KEYCHAIN_SERVICE=inmate
CLAUDE_ACCOUNT=claude-code-oauth-token
GITHUB_ACCOUNT=github-token

warn() { printf 'inmate: %s\n' "$*" >&2; }
die() { warn "$@"; exit 1; }

keychain_token() {
  security find-generic-password -s "$KEYCHAIN_SERVICE" -a "$1" -w 2>/dev/null
}

ensure_container_running() {
  command -v container > /dev/null || die "Apple 'container' CLI not found. Install with: brew install container"

  local status=0
  perl -e 'alarm shift; exec @ARGV' 15 container system status > /dev/null 2>&1 || status=$?
  if [ "$status" -eq 142 ]; then
    die "'container system status' hung (apple/container#2275). Try: sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setstealthmode on, then reboot."
  fi
  if [ "$status" -ne 0 ]; then
    warn "starting the container system service..."
    container system start "$@"
  fi
}

build_image() {
  local claude_version
  claude_version=$(curl -fsSL https://downloads.claude.ai/claude-code-releases/latest) || die "could not look up the Claude Code version"
  case "$claude_version" in
    *[!0-9.]*|'') die "unexpected Claude Code version: '$claude_version'" ;;
  esac

  local gh_version
  gh_version=$(curl -fsSLI -o /dev/null -w '%{url_effective}' https://github.com/cli/cli/releases/latest) \
    || die "could not look up the gh version"
  gh_version=${gh_version##*/v}
  case "$gh_version" in
    *[!0-9.]*|'') die "unexpected gh version: '$gh_version'" ;;
  esac

  # no dangling images
  container image delete "$IMAGE" > /dev/null 2>&1 || true

  container build -t "$IMAGE" \
    --build-arg CLAUDE_VERSION="$claude_version" \
    --build-arg GH_VERSION="$gh_version" \
    "$IMAGE_DIR" > /dev/null
}

claude_login() {
  [ -t 0 ] && [ -t 1 ] || die "Claude login needs an interactive terminal"

  local log token
  log=$(mktemp)
  script -q "$log" container run --rm -it -e TERM "$IMAGE" claude setup-token || true
  token=$(tr -d '\r' < "$log" | grep -o 'sk-ant-oat01-[A-Za-z0-9_-]*' | tail -1) || true
  rm -f "$log"

  case "$token" in
    '' | *[!A-Za-z0-9_-]*) die "Claude login failed: no token was printed" ;;
  esac

  printf 'add-generic-password -U -s %s -a %s -w %s\n' \
    "$KEYCHAIN_SERVICE" "$CLAUDE_ACCOUNT" "$token" | security -i
  printf 'Logged in. Token stored in the Keychain.\n'
}

github_login() {
  [ -t 0 ] && [ -t 1 ] || die "GitHub token entry needs an interactive terminal"

  local token
  read -r -s -p "GitHub token: " token
  printf '\n'
  case "$token" in
    '' | *[!A-Za-z0-9_-]*) warn "GitHub token not set" ;;
    *)
      printf 'add-generic-password -U -s %s -a %s -w %s\n' \
        "$KEYCHAIN_SERVICE" "$GITHUB_ACCOUNT" "$token" | security -i
      printf 'GitHub token stored in the Keychain.\n'
      ;;
  esac
}

start_xcode_bridge() {
  command -v socat > /dev/null || die "Xcode bridge needs socat: brew install socat"
  xcrun --find mcpbridge > /dev/null 2>&1 \
    || die "Xcode bridge needs an Xcode with mcpbridge (check xcode-select -p)"

  local base=$INMATE_XCODE_BRIDGE_PORT
  [[ $base =~ ^[1-9][0-9]{0,4}$ ]] && (( base + 19 <= 65535 )) \
    || die "INMATE_XCODE_BRIDGE_PORT must be a port number: '$base'"

  local net host_ip subnet
  net=$(container network inspect default)
  host_ip=$(jq -r '.[0].status.ipv4Gateway // empty' <<< "$net")
  subnet=$(jq -r '.[0].status.ipv4Subnet // empty' <<< "$net")
  case "$host_ip/$subnet" in
    *[!0-9./]* | /* | */) die "unexpected container network: '$host_ip' '$subnet'" ;;
  esac

  bridge_log=$(mktemp -t inmate-xcode)
  local port
  for (( port = base; port < base + 20; port++ )); do
    socat -d -d TCP-LISTEN:"$port",reuseaddr,fork,range="$subnet" \
      EXEC:"xcrun mcpbridge" < /dev/null > /dev/null 2>> "$bridge_log" &
    bridge_pid=$!
    # socat logs "listening on" once bound, or exits if port is taken
    until grep -q 'listening on' "$bridge_log" || ! kill -0 "$bridge_pid" 2>/dev/null; do
      sleep 0.05
    done
    if kill -0 "$bridge_pid" 2>/dev/null; then
      INMATE_XCODE_BRIDGE_ADDR=$host_ip:$port
      warn "Xcode bridge running at $INMATE_XCODE_BRIDGE_ADDR"
      return
    fi
    bridge_pid=
  done
  die "could not start the Xcode bridge: $(grep ' E ' "$bridge_log" | tail -n 1)"
}

cleanup() {
  set +e
  stty "$saved_tty" 2>/dev/null
  container stop "$name" > /dev/null 2>&1
  if [ -n "$bridge_pid" ]; then
    pkill -TERM -P "$bridge_pid"  # connection children first, or they're orphaned
    kill "$bridge_pid"
  fi 2>/dev/null
  [ -z "$bridge_log" ] || rm -f "$bridge_log"
}

cmd_run() {
  local project
  project=$(pwd -P)
  case "$project" in
    *[:,]*) die "project path contains ':' or ',' which 'container -v' can't mount: '$project'" ;;
    "$HOME"/*) ;;
  *) die "refusing to run outside home: '$project'"
  esac

  ensure_container_running 
  container image inspect "$IMAGE" > /dev/null 2>&1 || die "image not built; run inmate setup"
  CLAUDE_CODE_OAUTH_TOKEN=$(keychain_token "$CLAUDE_ACCOUNT") || die "not logged in; run inmate setup"
  GH_TOKEN=$(keychain_token "$GITHUB_ACCOUNT") || GH_TOKEN=
  : "${GIT_AUTHOR_NAME:=$(git config user.name)}"
  : "${GIT_AUTHOR_EMAIL:=$(git config user.email)}"
  : "${GIT_COMMITTER_NAME:=$GIT_AUTHOR_NAME}"
  : "${GIT_COMMITTER_EMAIL:=$GIT_AUTHOR_EMAIL}"

  name="inmate-$$-$RANDOM"  # global: the traps run outside cmd_run's scope
  bridge_pid= bridge_log= INMATE_XCODE_BRIDGE_ADDR=  # global: for cleanup

  local args=(run --rm -it -c "$INMATE_CPUS" -m "$INMATE_MEMORY" --name "$name" -v "$project:$project" -w "$project")

  local dir src
  for dir in $INMATE_SHADOW_DIRS; do
    src="$project/.inmate/shadow/$dir"
    mkdir -p "$src"
    [ "$(realpath "$src")" = "$src" ] || die "refusing symlinked shadow dir: '$src'"
    args+=(-v "$src:$project/$dir")
  done

  saved_tty=$(stty -g)
  trap cleanup EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM

  case "${INMATE_XCODE_BRIDGE-}" in
    '' | 0) ;;
    1) start_xcode_bridge ;;
    *) die "INMATE_XCODE_BRIDGE must be 1 or unset: '$INMATE_XCODE_BRIDGE'" ;;
  esac

  local var
  for var in CLAUDE_CODE_OAUTH_TOKEN GH_TOKEN TERM \
    GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL \
    INMATE_XCODE_BRIDGE_ADDR \
    ${INMATE_ENV-}; do
    if [ -n "${!var-}" ]; then
      export "${var?}"
      args+=(-e "$var")
    fi
  done

  stty -onlcr
  container "${args[@]}" "$IMAGE" "$@" <&0 &
  wait $!
}

cmd_setup() {
  ensure_container_running --enable-kernel-install
  build_image
  keychain_token "$CLAUDE_ACCOUNT" > /dev/null || claude_login
  keychain_token "$GITHUB_ACCOUNT" > /dev/null || github_login
  printf 'Setup complete.\n'
}

main() {
  case "${1-}" in
    '' | -h | --help) printf 'usage: inmate setup | inmate <cmd> [args]\n' ;;
    setup) cmd_setup ;;
    -*) die "unknown option '$1'" ;;
    *) cmd_run "$@" ;;
  esac
}

main "$@"
